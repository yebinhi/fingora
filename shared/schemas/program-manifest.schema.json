{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fingora.app/schemas/program-manifest/v1",
  "title": "FingoraProgramManifest",
  "description": "Offline practice bundle consumed by the iOS Practice Player",
  "type": "object",
  "required": ["manifestVersion", "programId", "title", "sections"],
  "properties": {
    "manifestVersion": { "type": "string", "const": "1" },
    "programId": { "type": "string" },
    "title": { "type": "string" },
    "difficulty": { "type": "string" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["sectionId", "order", "expectedNotes"],
      "properties": {
        "sectionId": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" },
        "sheetMusicRef": { "type": "string", "description": "Relative path or measure range" },
        "demoAudioRef": { "type": "string" },
        "expectedNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pitch", "startMs", "durationMs"],
            "properties": {
              "pitch": { "type": "string", "description": "e.g. C4" },
              "startMs": { "type": "number" },
              "durationMs": { "type": "number" },
              "finger": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      }
    }
  }
}
